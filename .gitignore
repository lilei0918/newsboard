# ── 编译产物 ─────────────────────────────────────────────────────────────────
build/

# ── 自带运行库（约 150MB：Qt6 等共享库 + 动态加载器 + Qt 插件）────────────────
# 由 tools/bundle-runtime.sh 从本机 Qt 环境重新生成，不进仓库
lib/

# ── 自带 Python（约 256MB：CPython + yfinance 等依赖）────────────────────────
# 由 tools/setup-runtime.sh 重新生成，或从打包好的目录整体拷贝，不进仓库
runtime/

# ── 运行期数据与个人配置 ─────────────────────────────────────────────────────
# 缓存、已读状态、窗口几何、自选标的、cookie 库都在这里，属于本机状态
data/
config/

# ── 本地产物 ─────────────────────────────────────────────────────────────────
*.ppm
__pycache__/
*.py[cod]
.nixcache/
.dsh-*.log
